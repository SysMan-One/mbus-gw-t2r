#++
#	FACILITY: A yet another gateway for MODBUS (TCP to RTU)
#
#	DESCRIPTION: The systemd unit of the gateway (packages install it disabled):
#		$ sudo systemctl enable --now mbusgw-t2r
#	The local changes (the settings file, TasksMax, ...) go to a drop-in, not here:
#		$ sudo systemctl edit mbusgw-t2r
#
#	The control utility talks to the gateway over /var/run/mbusgw-t2r.sock:
#		$ sudo mbus-ctl SHOW CONNECTIONS
#
#	A template: CMake puts the paths of the installation prefix in place of the @...@ names
#	(the package uses /usr/sbin and /etc/mbusgw-t2r).
#
#	CREATION DATE: 28-OCT-2026
#
#	06-NOV-2026	CLD	V.01-01: ExecReload= by mbus-ctl RESTART GATEWAY; it waits until the gateway
#				is back (up to /WAIT=30 s): 'systemctl reload' returns when it is done (RRL).
#
#	21-NOV-2026	CLD	V.01-01ECO03: the paths come from the installation prefix (configure_file): with another
#				prefix (-DCMAKE_INSTALL_PREFIX=/usr/local) the unit started a missing
#				/opt/mbusgw-t2r/sbin/mbusgw-t2r.
#--
[Unit]
Description=MODBUS TCP to RTU gateway (mbusgw-t2r)
Documentation=file:@CMAKE_INSTALL_FULL_DOCDIR@/README.md
After=network.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_SBINDIR@/mbusgw-t2r --settings=@T2R_CONFDIR@/modbus-t2r_settings.conf
Restart=on-failure
# 'systemctl reload': the gateway checks its settings and restarts itself (the same PID), see mbus-ctl;
# the reload ends when the gateway is up again (or the settings are refused - the old ones stay)
ExecReload=@CMAKE_INSTALL_FULL_SBINDIR@/mbus-ctl RESTART GATEWAY
RestartSec=5

[Install]
WantedBy=multi-user.target
