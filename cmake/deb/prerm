#!/bin/sh
#	mbusgw-t2r: the service is stopped on a removal (an upgrade restarts it in postinst).
#	The enabled state is configuration: it is kept until a purge (postrm), as conffiles are.
#	A failure to stop is told, it never blocks the removal.
set -e
if [ "$1" = "remove" ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
	deb-systemd-invoke stop mbusgw-t2r.service ||
		echo "mbusgw-t2r: stop of mbusgw-t2r.service failed" >&2
fi
exit 0
