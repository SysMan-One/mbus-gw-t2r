#!/bin/sh
#	mbusgw-t2r: the unit is installed disabled - the settings file has to be tuned first.
#	As dh_installsystemd does (--no-enable --restart-after-upgrade): deb-systemd-helper records
#	the links of the unit, so that a purge removes them (a manual 'systemctl enable' too), and
#	an enabled unit gets the new links (if any) of an upgraded unit file;
#	deb-systemd-invoke (policy-rc.d is respected) starts the unit on a fresh installation and
#	restarts it on an upgrade - only when it is enabled or running; abort-remove and the
#	other abort-* start an enabled unit again after a failed removal. A failure to (re)start
#	is told, it never leaves the package half-configured.
set -e
case "$1" in
configure|abort-upgrade|abort-deconfigure|abort-remove)
	if deb-systemd-helper debian-installed mbusgw-t2r.service; then
		if deb-systemd-helper --quiet was-enabled mbusgw-t2r.service; then
			deb-systemd-helper enable mbusgw-t2r.service >/dev/null || true
		fi
	fi
	deb-systemd-helper update-state mbusgw-t2r.service >/dev/null || true
	if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "${2:-}" ]; then
			l_action=restart
		else
			l_action=start
		fi
		deb-systemd-invoke "$l_action" mbusgw-t2r.service ||
			echo "mbusgw-t2r: $l_action of mbusgw-t2r.service failed, see: systemctl status mbusgw-t2r" >&2
	fi
	;;
esac
exit 0
